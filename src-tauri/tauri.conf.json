{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skillshelf",
  "version": "0.1.0",
  "identifier": "dev.sanchezroberto.skillshelf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skillshelf",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Claude Code skills & plugins manager",
    "longDescription": "Browse, filter and update the skills and plugins installed for Claude Code.",
    "category": "DeveloperTool"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNjgwQjdCODczOUQyNkYKUldSdjBqbUhld3Rvd055Z0h1ZUhNMTU0ai9oU0lBUDZZVExOUGlMM3FJU3BwcU9YM2RMMlF5UHUK",
      "endpoints": ["https://github.com/sanchezrobertodev/skillshelf/releases/latest/download/latest.json"]
    }
  }
}
